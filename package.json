{
  "name": "@neotap.app/cli",
  "version": "0.1.0",
  "description": "NeoTap creator CLI - authorize, inspect OpenAPI docs, and run AI generation tasks from the terminal.",
  "type": "module",
  "bin": {
    "neotap": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "neotap",
    "cli",
    "openapi",
    "game-assets"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "env-paths": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
